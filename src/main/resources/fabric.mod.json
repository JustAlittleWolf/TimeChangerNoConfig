{
  "schemaVersion": 1,
  "id": "timechangerupdated",
  "version": "${version}",

  "name": "Time Changer Updated",
  "description": "Allows you to change the time completely clientside!",
  "authors": [
    "JustAlittleWolf",
    "Motschen",
    "TeamMidnightDust"
  ],
  "contact": {
    "sources": "https://github.com/JustAlittleWolf/TimeChangerNoConfig/",
    "issues": "https://github.com/JustAlittleWolf/TimeChangerNoConfig/issues"
  },

  "license": "MIT",
  "icon": "assets/timechanger/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "me.wolfii.timechangerupdated.TimeChangerClient"
    ]
